# Copy to .env and fill in for this deployment. Every value is compiled into
# the bundle, so none of them may be a secret.

VITE_AUTH_API_URL=https://auth.example.com
VITE_API_URL=https://api.example.com
VITE_UPLOAD_API_URL=https://upload.example.com

# Company-login sign-in (single sign-on): the Keycloak realm's public
# address and the browser client. Both required — the app refuses to load
# without them.
VITE_KEYCLOAK_AUTHORITY=https://keycloak.example.com/realms/smartdoc_realm
VITE_KEYCLOAK_CLIENT_ID=smartdoc-browser
