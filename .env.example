# Copy to .env and fill in for this deployment. Every value is compiled into
# the bundle, so none of them may be a secret.

VITE_AUTH_API_URL=https://auth.example.com
VITE_API_URL=https://api.example.com
VITE_UPLOAD_API_URL=https://upload.example.com

# The largest a single document may be, end to end — must match
# S3_MAX_FILE_SIZE in smartdoc_upload_api and smartdoc_api. Only used to cap
# the per-project field on the Projects screen; the API enforces it.
VITE_MAX_FILE_BYTES=104857600
